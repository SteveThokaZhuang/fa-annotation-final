  "accepted_english_characters": {
    "policy": "Treat these characters as legitimate English transcript content; do not flag them as foreign characters.",
    "ascii_letters": "A-Z a-z",
    "digits": "0-9",
    "whitespace": "space, tab, newline, carriage return",
    "punctuation": ". , ! ? : ; ' \" ( ) [ ] { } < > - _ / \\",
    "currency": [
      "$",
      "€",
      "£",
      "¥",
      "¢"
